# frozen_string_literal: true

require "spec_helper"

RSpec.describe Sirena::Layout::<%= klass %> do
  let(:diagram) do
    Sirena::IR::Data.new(
      id: "<%= type %>",
      role: "ordered_list",
      items: [
        Sirena::IR::Item.new(id: "item_0", label: "a", role: "list_item"),
        Sirena::IR::Item.new(id: "item_1", label: "b", role: "list_item"),
      ],
    )
  end

  it "returns a Scene" do
    expect(described_class.new.call(diagram))
      .to be_a(described_class::Scene)
  end

  it "gives each item a row below the previous one" do
    ys = described_class.new.call(diagram).rows.map(&:y)

    expect(ys).to eq(ys.sort.uniq)
  end

  it "uses shared data labels as row text" do
    rows = described_class.new.call(diagram).rows

    expect(rows.map(&:text)).to eq(%w[a b])
  end
end
