try":"info","kind":"capture","input":"info showInfo","expect":{"header":"info","show_info":"showInfo"}}],"docs":{"sp":"------------------------------------------------------------------\nCommon (grammars/common.rb)\n------------------------------------------------------------------\nspace: a blank within a line.","comment":"comment: \"%%\" to end of line (a lone CR stays in the comment).","line_end":"line_end: optional \";\", trailing blanks, then an optional comment\nand a newline, or end of input.","info_flag":"------------------------------------------------------------------\ninfo (grammars/info.rb)\n------------------------------------------------------------------","pie_title_text":"------------------------------------------------------------------\npie (grammars/pie.rb)\n------------------------------------------------------------------"},"source":"# Mermaid grammar -- PARG source (parsanol grammar language).\n# Extraction target: the hand-written Parslet grammars in\n# claricle/sirena lib/sirena/parser/grammars/*.rb -- the rules below mirror\n# those grammars rule for rule (same whitespace set, same line_end, same\n# quoting rules), so the native path and the Ruby fallback accept the same\n# language. One entry per diagram type; sirena routes by diagram keyword\n# and falls back to the Parslet grammar for every type not yet here and for\n# every input an entry here rejects (so error messages stay positioned).\n# Compile: parsanol parg compile mermaid.parg -o mermaid.json\n\ngrammar Mermaid version \"0.1.0\" edition 2 {\n\n  ## ------------------------------------------------------------------\n  ## Common (grammars/common.rb)\n  ## ------------------------------------------------------------------\n\n  ## space: a blank within a line.\n  sp = %x20 / %x09\n\n  newline = %x0A / %x0D.0A\n\n  ## comment: \"%%\" to end of line (a lone CR stays in the comment).\n  comment = \"%%\" *( !%x0A ANY )\n\n  ws = *( sp / newline / comment )\n\n  eof = !ANY\n\n  ## line_end: optional \";\", trailing blanks, then an optional comment\n  ## and a newline, or end of input.\n  line_end = [\";\"] *sp ( [comment] newline / eof )\n\n  rest_of_line = *( !line_end ANY )\n\n  dq_string = %x22 *( \"\\\\\" ANY / !%x22 ANY ) as string %x22\n\n  sq_string = \"'\" *( \"\\\\\" ANY / !\"'\" ANY ) as string \"'\"\n\n  ## ------------------------------------------------------------------\n  ## info (grammars/info.rb)\n  ## ------------------------------------------------------------------\n\n  info_flag = \"showInfo\" as show_info\n\n  info_body_line = *sp info_flag line_end\n\n  info = ws \"info\" as header [ 1*sp info_flag ] ws [ 1*info_body_line as body ] ws\n\n  entry info: info\n\n  ## ------------------------------------------------------------------\n  ## pie (grammars/pie.rb)\n  ## ------------------------------------------------------------------\n\n  pie_title_text = *( !line_end ANY )\n\n  pie_title = \"title\" ( \":\" / 1*sp ) pie_title_text as text\n\n  pie_header = \"pie\" [ 1*sp \"showData\" as show_data ] [ 1*sp pie_title as title ] ws\n\n  pie_acc_title = \"accTitle\" [sp] \":\" [sp] rest_of_line as text line_end\n\n  pie_acc_descr_single = \"accDescr\" [sp] \":\" [sp] rest_of_line as text line_end\n\n  pie_acc_descr_multi = \"accDescr\" [sp] \"{\" ws *( !\"}\" ANY ) as text ws \"}\" line_end\n\n  pie_standalone_title = *sp \"title\" 1*sp pie_title_text as text line_end\n\n  pie_label = dq_string / sq_string\n\n  pie_number = [\"-\"] ( 1*DIGIT \".\" 1*DIGIT / 1*DIGIT )\n\n  pie_entry = *sp pie_label as label *sp \":\" *sp pie_number as value line_end\n\n  pie_statement = pie_acc_title as acc_title / pie_acc_descr_single as acc_descr / pie_acc_descr_multi as acc_descr / pie_standalone_title as standalone_title / pie_entry as entry / comment line_end\n\n  pie = ws pie_header *( pie_statement ws ) ws\n\n  entry pie: pie\n  \n  test pie {\n    accept \"pie\"\n    accept \"pie showData title Pets\"\n    accept \"pie\\n  \\\"A\\\" : 1\\n  \\\"B\\\" : 2.5\"\n    reject \"pie\\n  A : 1\"\n  }\n\n  test info {\n    accept \"info\"\n    accept \"info showInfo\"\n    accept \"info\\nshowInfo\"\n    reject \"inf\"\n    reject \"info other\"\n    capture \"info showInfo\" { header: \"info\"\n      show_info: \"showInfo\" }\n  }\n}\n","source_hash":"9d965c0477d01df79c3cc3e57c74ecd0927b0369e3c2e778bf5384f2d5bd354d","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.130","edition":2,"semantics_hash":"sha256:8054a26b170a5f9d46f45c0adf73d2d01cba05406941354a5844991828b28aca","checksum":"sha256:11aa39ecadd9388a4704abcf566a0373353af34182a16917c97dba6cdf0cbd86"}
