@startsalt
{
    {T!
        + <b>TOC</b> | table of contents | .
        ++ <b>TOCI</b> | table of contents item | .
        ++ <b>P</b> | paragraph | .
        +++ <b>Reference</b> | . | .
        ++++ <b>Lbl</b> | label | In cases where the TOCI is numbered
        ++++ <b>Span</b> | . | "Introduction .................. page 5"
    }
}
@endsalt
