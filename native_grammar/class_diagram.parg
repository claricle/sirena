  class_diagram = ws class_header ws [ 1*( class_statement ws ) as statements ] ws

  entry class_diagram: class_diagram

  test class_diagram {
    accept "classDiagram"
    accept "classDiagram-v2\n  A <|-- B"
    accept "classDiagram LR\n  class A {\n    +int x\n    +run() void\n  }\n  A : +y"
    accept "classDiagram\n  namespace N {\n    class A\n  }\n  note for A \"hi\""
    reject "classDiagram LR extra"
    reject "classDiagram\n  A <|-- "
  }
