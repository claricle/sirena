  class_colon_annotation_text = 1*( 1*( !( "\n" / "%" / ":" / ";" / ">" / "{" / "}" ) ANY ) / !( ">>" class_member_end ) !( ":" / ";" ) class_body_char )

  class_colon_body_annotation = "<<" ( class_colon_annotation_text as body_stereotype / "" as body_stereotype ) ">>" class_member_end

