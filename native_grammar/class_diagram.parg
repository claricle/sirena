 / %xA640-A66E / %xA67F-A697 / %xA6A0-A6E5 / %xA717-A71F / %xA722-A788 / %xA78B-A78E / %xA790-A793 / %xA7A0-A7AA / %xA7F8-A801 / %xA803-A805 / %xA807-A80A / %xA80C-A822 / %xA840-A873 / %xA882-A8B3 / %xA8F2-A8F7 / %xA8FB / %xA90A-A925 / %xA930-A946 / %xA960-A97C / %xA984-A9B2 / %xA9CF / %xAA00-AA28 / %xAA40-AA42 / %xAA44-AA4B / %xAA60-AA76 / %xAA7A / %xAA80-AAAF / %xAAB1 / %xAAB5 / %xAAB6 / %xAAB9-AABD / %xAAC0 / %xAAC2 / %xAADB-AADD / %xAAE0-AAEA / %xAAF2-AAF4 / %xAB01-AB06 / %xAB09-AB0E / %xAB11-AB16 / %xAB20-AB26 / %xAB28-AB2E / %xABC0-ABE2 / %xAC00-D7A3 / %xD7B0-D7C6 / %xD7CB-D7FB / %xF900-FA6D / %xFA70-FAD9 / %xFB00-FB06 / %xFB13-FB17 / %xFB1D / %xFB1F-FB28 / %xFB2A-FB36 / %xFB38-FB3C / %xFB3E / %xFB40 / %xFB41 / %xFB43 / %xFB44 / %xFB46-FBB1 / %xFBD3-FD3D / %xFD50-FD8F / %xFD92-FDC7 / %xFDF0-FDFB / %xFE70-FE74 / %xFE76-FEFC / %xFF21-FF3A / %xFF41-FF5A / %xFF66-FFBE / %xFFC2-FFC7 / %xFFCA-FFCF / %xFFD2-FFD7 / %xFFDA-FFDC

  class_name_char = ALPHA / DIGIT / "_" / class_unicode_letter

  class_rest = 1*( !line_end ANY )

  class_direction_value = ( "TD" / "TB" / "LR" / "RL" / "BT" ) as dir_value

  class_header = "classDiagram-v2" as header *sp &( newline / eof ) ws / "classDiagram" as header !( class_name_char / "-" ) *sp [ class_direction_value as direction ] *sp &( newline / eof ) ws

  class_backtick_name = "`" 1*( !"`" ANY ) "`"

  class_hyphenated_word = 1*class_name_char *( "-" 1*class_name_char )

  class_plain_name = class_hyphenated_word *( "." class_hyphenated_word )

  class_name = class_backtick_name / class_plain_name

  class_generic_params = "~" 1*( !"~" ANY ) as generic_type "~"

  class_ref = class_name as class_id [ *sp class_generic_params as generic ]

  class_label_string = %x22 *( !%x22 ANY ) as string %x22

  class_text_label = "[" *sp class_label_string *sp "]"

  class_stereotype = "<<" 1*( !">>" ANY ) as stereotype_value ">>"

  class_css_shorthand = ":::" *sp 1*class_name_char as css_class

  class_member_end = *sp &( comment / newline / "}" / eof )

  class_body_char = !( "%%" / %x0A / "{" / "}" ) ANY

  class_body_text = !%x22 class_body_char *class_body_char class_member_end

  class_indented_quote_text = %x22 *class_body_char class_member_end

  class_annotation_text = 1*( !( ">>" class_member_end ) class_body_char )

  class_body_annotation = "<<" ( class_annotation_text as body_stereotype / "" as body_stereotype ) ">>" class_member_end

  class_colon_annotation_text = 1*( !( ">>" class_member_end ) !( ":" / ";" ) class_body_char )

  class_colon_body_annotation = "<<" ( class_colon_annotation_text as body_stereotype / "" as body_stereotype ) ">>" class_member_end

  class_colon_text = 1*( !( ":" / ";" / %x0A ) !line_end ANY )

  class_identifier = ( ALPHA / "_" ) *( ALPHA / DIGIT / "_" )

  class_type_expression = ( ALPHA / "_" ) *( ALPHA / DIGIT / "_" / "<" / ">" ) [ "~" *( !"~" ANY ) "~" ]

  class_method_return_type = *sp ":" *sp class_type_expression as type

  class_method_params = 1*( !")" ANY )

  class_method_definition = class_identifier as method_name "(" [ class_method_params as parameters ] ")" [ class_method_return_type as return_type ]

  class_attribute_definition = class_type_expression as type sp class_identifier as attr_name / class_identifier as attr_name [ *sp ":" *sp class_type_expression as type ]

  class_member_definition = class_method_definition / class_attribute_definition

  class_visibility = ( "+" / "-" / "#" / "~" ) as vis_symbol

  class_member = 1*sp class_indented_quote_text as raw_member / *sp ( class_body_annotation / [ class_visibility as visibility ] class_member_definition as member class_member_end / class_body_text as raw_member )

  class_body_gap = *( *sp ( newline / comment ) )

  class_members = 1*( class_member class_body_gap )

  class_body = "{" class_body_gap [ class_members as body ] ws "}"

  class_declaration_end = ";" *sp ( [comment] newline / eof ) / *sp ( [comment] newline / &( "}" / eof ) )

  class_declaration = "class" as keyword sp class_name as class_id *sp [ class_generic_params as generic ] *sp [ class_text_label as text_label ] *sp ( class_css_shorthand / [ class_stereotype as stereotype ] ) *sp [ class_body ] class_declaration_end

  class_standalone_stereotype = class_stereotype as stereotype sp class_name as class_id line_end

  class_colon_member = class_ref *sp ":" *sp ( class_colon_body_annotation line_end / [ class_visibility as visibility ] class_member_definition as member line_end / class_colon_text as raw_member line_end )

  class_string = dq_string / sq_string

  class_link = "link" as link_keyword sp class_name as class_id sp class_string as url [ sp class_string as tooltip ] line_end

  class_callback = "callback" as callback_keyword sp class_name as class_id sp class_string as callback_fn [ sp class_string as tooltip ] line_end

  class_click = "click" as ignored sp class_name [ sp class_rest ] line_end

  class_style = "style" as ignored sp class_name sp class_rest line_end

  class_css_class = "cssClass" as ignored sp dq_string sp class_name line_end

  class_class_def = "classDef" as ignored sp class_rest line_end

  class_direction = "direction" as direction_keyword sp class_direction_value line_end

  class_acc_title = "accTitle" as ignored *sp ":" [ class_rest ] line_end

  class_acc_descr = "accDescr" as ignored *sp ( ":" [ class_rest ] / "{" *( !"}" ANY ) "}" ) line_end

  class_note = "note" as ignored [ sp "for" sp class_name as note_for ] sp class_rest as note_text line_end

  class_standalone = class_ref line_end

  class_cardinality = class_string

    class_operator = ( "|>..|>" / "|>..<|" / "|>--|>" / "|>--<|" / "<|..|>" / "<|..<|" / "<|--<|" / "<|--|>" / "*--<|" / "*--|>" / "*..<|" / "*..|>" / "o--<|" / "o--|>" / "o..<|" / "o..|>" / ">..|>" / ">..<|" / "<--<|" / "<--|>" / "<..<|" / "<..|>" / ">--|>" / ">--<|" / "<|--*" / "<|--o" / "<|--<" / "<|-->" / "<|..*" / "<|..o" / "<|..<" / "<|..>" / "|>--*" / "|>--o" / "|>--<" / "|>-->" / "|>..>" / "|>..<" / "|>..o" / "|>..*" / "*--<" / "<..*" / "<..o" / "<..<" / "<..>" / "*--o" / "*--*" / ">--*" / ">--o" / ">--<" / ">-->" / ">..*" / ">..o" / ">..<" / ">..>" / "*..>" / "*..<" / "o--*" / "o--o" / "o--<" / "o-->" / "*..o" / "*..*" / "o..*" / "o..o" / "o..<" / "o..>" / "<--*" / "<--o" / "<--<" / "<-->" / "*-->" / "o.." / "<|--" / "--|>" / "*--" / "--*" / "o--" / "--o" / "..|>" / "<|.." / "..>" / "<.." / "-->" / "<--" / "--" / ".." ) as arrow

  class_pipe_label = "|" 1*( !"|" ANY ) as label_text "|"

  class_colon_label = *sp ":" *sp 1*( !line_end ANY ) as label_text

  class_relationship = class_name as from_id [ *sp class_generic_params as from_generic ] *sp [ class_cardinality as source_card ] *sp class_operator as operator *sp [ class_pipe_label as pipe_label ] *sp [ class_cardinality as target_card ] *sp class_name as to_id [ *sp class_generic_params as to_generic ] [ class_colon_label as colon_label ] line_end

  class_namespace_name = 1*( ALPHA / DIGIT / "_" / "." / "-" )

  class_namespace_statement = class_declaration / class_standalone_stereotype / class_colon_member / class_relationship / class_standalone

  class_namespace = "namespace" as namespace_keyword sp class_namespace_name as namespace_name *sp "{" ws [ 1*( class_namespace_statement ws ) as namespace_body ] ws "}" line_end

  class_statement = class_acc_title / class_acc_descr / class_namespace / class_declaration / class_standalone_stereotype / class_colon_member / class_relationship / class_link / class_callback / class_click / class_style / class_css_class / class_class_def / class_direction / class_note / class_standalone

  class_diagram = ws class_header ws [ 1*( class_statement ws ) as statements ] ws

  entry class_diagram: class_diagram

  test class_diagram {
    accept "classDiagram"
    accept "classDiagram-v2\n  A <|-- B"
    accept "classDiagram LR\n  class A {\n    +int x\n    +run() void\n  }\n  A : +y"
    accept "classDiagram\n  namespace N {\n    class A\n  }\n  note for A \"hi\""
    reject "classDiagram LR extra"
    reject "classDiagram\n  A <|-- "
  }
