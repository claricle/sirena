# frozen_string_literal: true

source 'https://rubygems.org'

gem 'jekyll', '4.4.1'
gem 'jekyll-asciidoc', '3.0.1'
gem 'jekyll-seo-tag', '2.9.0'
gem 'jekyll-sitemap', '1.4.0'
gem 'just-the-docs', '0.12.0'

# The docs-site verifier (scripts/verify_docs_site.rb) parses the BUILT
# HTML with a real HTML5 parser, and CI runs it under THIS bundle -- the
# workflow only ever installs docs/Gemfile. Declared here so the verify
# step cannot fail with LoadError on a machine where nothing else
# happens to pull nokogiri in.
gem 'nokogiri', '1.19.4'

group :jekyll_plugins do
  gem 'asciidoctor', '2.0.26'
end
